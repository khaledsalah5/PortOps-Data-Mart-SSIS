                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    equipment_id,
    LTRIM(RTRIM(equipment_code)) AS equipment_code,
    LTRIM(RTRIM(equipment_type)) AS equipment_type,
    terminal_id,
    capacity_tons,
    acquired_date,
    LTRIM(RTRIM(status)) AS status,
    row_hash
FROM silver.Equipment
WHERE is_valid = 1;</property>
