          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="UPDATE audit.package_execution_log&#xA;SET&#xA;    end_time = SYSUTCDATETIME(),&#xA;    status = 'Failed',&#xA;    error_message = '00_Master.dtsx failed. Check child package execution logs and SSIS messages.'&#xA;WHERE package_name = '00_Master.dtsx'&#xA;  AND status = 'Running';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
