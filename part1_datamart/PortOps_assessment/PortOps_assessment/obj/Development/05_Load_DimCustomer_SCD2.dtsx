                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select * from (SELECT
    customer_id,
    row_hash_type1 AS lkp_row_hash_type1
FROM gold.dim_customer
WHERE is_current = 1
  AND customer_sk &lt;&gt; -1;) [refTable]
where [refTable].[customer_id] = ?</property>
