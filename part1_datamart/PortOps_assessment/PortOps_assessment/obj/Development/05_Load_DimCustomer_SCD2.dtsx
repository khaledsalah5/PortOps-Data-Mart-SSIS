            <component
              refId="Package\DFT_Load_Customer_SCD2_Versions\SRC_Customer_SCD2_Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_Customer_SCD2_Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH CustomerSCDSource AS (
    SELECT
        c.customer_id,
        LTRIM(RTRIM(c.customer_code)) AS customer_code,
        LTRIM(RTRIM(c.customer_name)) AS customer_name,
        LTRIM(RTRIM(c.country)) AS country,
        c.active_flag,
        c.onboarded_date,

        LTRIM(RTRIM(h.customer_tier)) AS customer_tier,
        h.credit_limit,
        LTRIM(RTRIM(h.change_reason)) AS change_reason,

        h.effective_from,
        ISNULL(h.effective_to, CONVERT(DATE, '9999-12-31')) AS effective_to,

        CASE 
            WHEN h.effective_to IS NULL OR h.effective_to = CONVERT(DATE, '9999-12-31') THEN 1
            ELSE 0
        END AS is_current,

        CONVERT(VARCHAR(64), HASHBYTES('SHA2_256',
            CONCAT(
                ISNULL(LTRIM(RTRIM(c.customer_code)), ''), '|',
                ISNULL(LTRIM(RTRIM(c.customer_name)), ''), '|',
                ISNULL(LTRIM(RTRIM(c.country)), ''), '|',
                ISNULL(CAST(c.active_flag AS VARCHAR(5)), ''), '|',
                ISNULL(CONVERT(VARCHAR(10), c.onboarded_date, 120), '')
            )
        ), 2) AS row_hash_type1,

        CONVERT(VARCHAR(64), HASHBYTES('SHA2_256',
            CONCAT(
                ISNULL(LTRIM(RTRIM(h.customer_tier)), ''), '|',
                ISNULL(CAST(h.credit_limit AS VARCHAR(50)), '')
            )
        ), 2) AS row_hash_type2

    FROM silver.Customers c
    INNER JOIN silver.CustomerHistory h
        ON c.customer_id = h.customer_id
    WHERE c.is_valid = 1
      AND h.is_valid = 1

    UNION ALL

    SELECT
        c.customer_id,
        LTRIM(RTRIM(c.customer_code)) AS customer_code,
        LTRIM(RTRIM(c.customer_name)) AS customer_name,
        LTRIM(RTRIM(c.country)) AS country,
        c.active_flag,
        c.onboarded_date,

        LTRIM(RTRIM(c.customer_tier)) AS customer_tier,
        c.credit_limit,
        'Current customer record - no history found' AS change_reason,

        ISNULL(c.onboarded_date, CONVERT(DATE, '1900-01-01')) AS effective_from,
        CONVERT(DATE, '9999-12-31') AS effective_to,
        1 AS is_current,

        CONVERT(VARCHAR(64), HASHBYTES('SHA2_256',
            CONCAT(
                ISNULL(LTRIM(RTRIM(c.customer_code)), ''), '|',
                ISNULL(LTRIM(RTRIM(c.customer_name)), ''), '|',
                ISNULL(LTRIM(RTRIM(c.country)), ''), '|',
                ISNULL(CAST(c.active_flag AS VARCHAR(5)), ''), '|',
                ISNULL(CONVERT(VARCHAR(10), c.onboarded_date, 120), '')
            )
        ), 2) AS row_hash_type1,

        CONVERT(VARCHAR(64), HASHBYTES('SHA2_256',
            CONCAT(
                ISNULL(LTRIM(RTRIM(c.customer_tier)), ''), '|',
                ISNULL(CAST(c.credit_limit AS VARCHAR(50)), '')
            )
        ), 2) AS row_hash_type2

    FROM silver.Customers c
    WHERE c.is_valid = 1
      AND NOT EXISTS (
          SELECT 1
          FROM silver.CustomerHistory h
          WHERE h.customer_id = c.customer_id
            AND h.is_valid = 1
      )
)
SELECT *
FROM CustomerSCDSource;</property>
