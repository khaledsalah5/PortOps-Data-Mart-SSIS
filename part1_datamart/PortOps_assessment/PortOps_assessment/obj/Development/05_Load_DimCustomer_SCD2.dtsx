    <DTS:Executable
      DTS:refId="Package\SQL_Check_dim_customer_SCD2_Quality"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AB5C3AC3-AF3A-4807-9FFF-13DC8F24A32A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Check_dim_customer_SCD2_Quality"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="-- Check 1: Only one current row per customer&#xA;IF EXISTS (&#xA;    SELECT customer_id&#xA;    FROM gold.dim_customer&#xA;    WHERE customer_sk &lt;&gt; -1&#xA;      AND is_current = 1&#xA;    GROUP BY customer_id&#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;BEGIN&#xA;    THROW 50001, 'SCD2 validation failed: More than one current row exists for a customer.', 1;&#xA;END;&#xA;&#xA;-- Check 2: effective_to must not be before effective_from&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.dim_customer&#xA;    WHERE customer_sk &lt;&gt; -1&#xA;      AND effective_to &lt; effective_from&#xA;)&#xA;BEGIN&#xA;    THROW 50002, 'SCD2 validation failed: effective_to is before effective_from.', 1;&#xA;END;&#xA;&#xA;-- Check 3: Current rows should end at 9999-12-31&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.dim_customer&#xA;    WHERE customer_sk &lt;&gt; -1&#xA;      AND is_current = 1&#xA;      AND effective_to &lt;&gt; '9999-12-31'&#xA;)&#xA;BEGIN&#xA;    THROW 50003, 'SCD2 validation failed: Current customer row does not end at 9999-12-31.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_End_Audit_Failed"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{85C40B4E-31E3-4EDD-9B5B-1581304CC710}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_End_Audit_Failed"
