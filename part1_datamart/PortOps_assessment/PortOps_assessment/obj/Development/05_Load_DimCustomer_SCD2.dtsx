      DTS:ObjectName="SQL_Log_Row_Counts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="INSERT INTO audit.customer_scd2_load_count_log (&#xA;    ingest_batch_id,&#xA;    package_name,&#xA;    inserted_rows,&#xA;    type2_updated_rows,&#xA;    type1_updated_rows,&#xA;    unchanged_rows,&#xA;    total_gold_rows,&#xA;    current_customer_rows&#xA;)&#xA;SELECT&#xA;    ? AS ingest_batch_id,&#xA;    ? AS package_name,&#xA;    ? AS inserted_rows,&#xA;    ? AS type2_updated_rows,&#xA;    ? AS type1_updated_rows,&#xA;    ? AS unchanged_rows,&#xA;    COUNT(*) AS total_gold_rows,&#xA;    SUM(CASE WHEN is_current = 1 THEN 1 ELSE 0 END) AS current_customer_rows&#xA;FROM gold.dim_customer&#xA;WHERE customer_sk &lt;&gt; -1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::IngestBatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::CustomerInsertedRows"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::CustomerType2UpdatedRows"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::CustomerType1UpdatedRows"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::CustomerUnchangedRows"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
