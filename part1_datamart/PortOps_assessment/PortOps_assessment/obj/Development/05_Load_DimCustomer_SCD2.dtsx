                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    customer_id,
    LTRIM(RTRIM(customer_code)) AS customer_code,
    LTRIM(RTRIM(customer_name)) AS customer_name,
    LTRIM(RTRIM(country)) AS country,
    active_flag,
    onboarded_date,

    CONVERT(VARCHAR(64), HASHBYTES('SHA2_256',
        CONCAT(
            ISNULL(LTRIM(RTRIM(customer_code)), ''), '|',
            ISNULL(LTRIM(RTRIM(customer_name)), ''), '|',
            ISNULL(LTRIM(RTRIM(country)), ''), '|',
            ISNULL(CAST(active_flag AS VARCHAR(5)), ''), '|',
            ISNULL(CONVERT(VARCHAR(10), onboarded_date, 120), '')
        )
    ), 2) AS row_hash_type1
FROM silver.Customers
WHERE is_valid = 1;</property>
