          SQLTask:SqlStatementSource="INSERT INTO audit.package_execution_log (&#xA;    ingest_batch_id,&#xA;    package_name,&#xA;    start_time,&#xA;    status&#xA;)&#xA;VALUES (&#xA;    ?,&#xA;    ?,&#xA;    SYSUTCDATETIME(),&#xA;    'Running'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="$Project::p_ingest_batch_id"
