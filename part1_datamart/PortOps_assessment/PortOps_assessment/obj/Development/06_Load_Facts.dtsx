            <component
              refId="Package\DFT_Load_fact_gate_transaction\SRC_silver_VesselCalls_Resolved"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC_silver_VesselCalls_Resolved"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
gt.gate_txn_id,

    ISNULL(d_in.date_key, -1) AS gate_in_date_key,
    ISNULL(d_out.date_key, -1) AS gate_out_date_key,

    ISNULL(dc.customer_sk, -1) AS customer_sk,
    ISNULL(dt.terminal_sk, -1) AS terminal_sk,
    ISNULL(ds.shift_sk, -1) AS shift_sk,

    LTRIM(RTRIM(gt.truck_plate)) AS truck_plate,
    LTRIM(RTRIM(gt.container_no)) AS container_no,
    LTRIM(RTRIM(gt.direction)) AS direction,

    gt.gate_in_time,
    gt.gate_out_time,

    CAST(gt.gate_processing_minutes AS DECIMAL(10,2))
    AS truck_turnaround_minutes,

    gt.ingest_batch_id

FROM silver.GateTransactions gt

LEFT JOIN gold.dim_date d_in
    ON d_in.full_date = CAST(gt.gate_in_time AS DATE)

LEFT JOIN gold.dim_date d_out
    ON d_out.full_date = CAST(gt.gate_out_time AS DATE)

LEFT JOIN gold.dim_terminal dt
    ON dt.terminal_id = gt.terminal_id

LEFT JOIN gold.dim_shift ds
    ON ds.shift_id = gt.shift_id

LEFT JOIN gold.dim_customer dc
    ON dc.customer_id = gt.customer_id
   AND CAST(gt.gate_out_time AS DATE) BETWEEN dc.effective_from AND dc.effective_to

WHERE gt.is_valid = 1;</property>
