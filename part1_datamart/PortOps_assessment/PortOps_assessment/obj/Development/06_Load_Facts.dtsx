    <DTS:Executable
      DTS:refId="Package\SQL_Check_Fact_Quality"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{152E9C48-717B-4889-B86E-28E718CB11CB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Check_Fact_Quality"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="-- Container movement cycle time cannot be negative&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.fact_container_movement&#xA;    WHERE crane_cycle_seconds &lt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51001, 'Fact quality failed: negative crane_cycle_seconds found.', 1;&#xA;END;&#xA;&#xA;-- Gate turnaround cannot be negative&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.fact_gate_transaction&#xA;    WHERE truck_turnaround_minutes &lt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51002, 'Fact quality failed: negative truck_turnaround_minutes found.', 1;&#xA;END;&#xA;&#xA;-- Vessel stay hours cannot be negative&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.fact_vessel_call&#xA;    WHERE stay_hours &lt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51003, 'Fact quality failed: negative vessel stay_hours found.', 1;&#xA;END;&#xA;&#xA;-- Fact foreign keys should not be NULL&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.fact_container_movement&#xA;    WHERE customer_sk IS NULL&#xA;       OR terminal_sk IS NULL&#xA;       OR equipment_sk IS NULL&#xA;       OR shift_sk IS NULL&#xA;       OR move_date_key IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51004, 'Fact quality failed: NULL foreign key found in fact_container_movement.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.fact_gate_transaction&#xA;    WHERE customer_sk IS NULL&#xA;       OR terminal_sk IS NULL&#xA;       OR shift_sk IS NULL&#xA;       OR gate_in_date_key IS NULL&#xA;       OR gate_out_date_key IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51005, 'Fact quality failed: NULL foreign key found in fact_gate_transaction.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM gold.fact_vessel_call&#xA;    WHERE customer_sk IS NULL&#xA;       OR terminal_sk IS NULL&#xA;       OR eta_date_key IS NULL&#xA;       OR ata_date_key IS NULL&#xA;       OR atd_date_key IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51006, 'Fact quality failed: NULL foreign key found in fact_vessel_call.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_End_Audit_Failed"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1ff8e9e4-a9c0-435d-bbbe-625d2b360290}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_End_Audit_Failed"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="UPDATE audit.package_execution_log&#xA;SET&#xA;    end_time = SYSUTCDATETIME(),&#xA;    status = 'Failed',&#xA;    error_message = ?&#xA;WHERE ingest_batch_id = ?&#xA;  AND package_name = ?&#xA;  AND status = 'Running';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::ErrorMessage"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::IngestBatchId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_End_Audit_Success"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7a1e4503-a9b1-4850-96ec-2553773a1af2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_End_Audit_Success"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="UPDATE audit.package_execution_log&#xA;SET&#xA;    end_time = SYSUTCDATETIME(),&#xA;    status = 'Succeeded',&#xA;    error_message = NULL&#xA;WHERE ingest_batch_id = ?&#xA;  AND package_name = ?&#xA;  AND status = 'Running';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="$Project::p_ingest_batch_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="NewParameterName"
            SQLTask:DtsVariableName="User::PackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Log_Row_Counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{30771581-2F31-4B2C-BD45-E3B21F6CCD93}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Log_Row_Counts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CA777945-62A9-4145-9F78-0B8DEAD96D45}"
          SQLTask:SqlStatementSource="INSERT INTO audit.fact_load_count_log (&#xA;    ingest_batch_id,&#xA;    package_name,&#xA;    fact_name,&#xA;    loaded_rows,&#xA;    target_rows&#xA;)&#xA;SELECT&#xA;    1,&#xA;    '06_Load_Facts.dtsx',&#xA;    'fact_vessel_call',&#xA;    COUNT(*),&#xA;    COUNT(*)&#xA;FROM gold.fact_vessel_call;&#xA;&#xA;INSERT INTO audit.fact_load_count_log (&#xA;    ingest_batch_id,&#xA;    package_name,&#xA;    fact_name,&#xA;    loaded_rows,&#xA;    target_rows&#xA;)&#xA;SELECT&#xA;    1,&#xA;    '06_Load_Facts.dtsx',&#xA;    'fact_container_movement',&#xA;    COUNT(*),&#xA;    COUNT(*)&#xA;FROM gold.fact_container_movement;&#xA;&#xA;INSERT INTO audit.fact_load_count_log (&#xA;    ingest_batch_id,&#xA;    package_name,&#xA;    fact_name,&#xA;    loaded_rows,&#xA;    target_rows&#xA;)&#xA;SELECT&#xA;    1,&#xA;    '06_Load_Facts.dtsx',&#xA;    'fact_gate_transaction',&#xA;    COUNT(*),&#xA;    COUNT(*)&#xA;FROM gold.fact_gate_transaction;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Start_Audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{450686ed-ca05-4ee7-8788-5590f6e70d56}"
